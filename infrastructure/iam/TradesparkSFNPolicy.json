      ]
    },
    {
      "Sid": "StartNestedStateMachines",
      "Effect": "Allow",
      "Action": ["states:StartExecution"],
      "Resource": [
        "arn:aws:states:us-east-1:822233328169:stateMachine:Predixa-AAPL-ML-Then-Tiers",
        "arn:aws:states:us-east-1:822233328169:stateMachine:Predixa-AAPL-Y2Y3",
        "arn:aws:states:us-east-1:822233328169:stateMachine:Predixa-AMZN-ML-Then-Tiers",
        "arn:aws:states:us-east-1:822233328169:stateMachine:Predixa-AMZN-Y2Y3"
      ]
    },
    {
      "Sid": "DescribeNestedExecutions",
      "Effect": "Allow",
      "Action": [
        "states:DescribeExecution",
        "states:StopExecution"
      ],
      "Resource": [
        "arn:aws:states:us-east-1:822233328169:execution:Predixa-AAPL-ML-Then-Tiers:*",
        "arn:aws:states:us-east-1:822233328169:execution:Predixa-AAPL-Y2Y3:*",
        "arn:aws:states:us-east-1:822233328169:execution:Predixa-AMZN-ML-Then-Tiers:*",
        "arn:aws:states:us-east-1:822233328169:execution:Predixa-AMZN-Y2Y3:*"
      ]
    },
    {
      "Sid": "EventBridgeForSyncNested",
      "Effect": "Allow",
      "Action": [
        "events:PutTargets",
        "events:PutRule",
        "events:DescribeRule"
      ],
      "Resource": [
        "arn:aws:events:us-east-1:822233328169:rule/StepFunctionsGetEventsForStepFunctionsExecutionRule"
      ]
    },
    {
      "Sid": "LogsForSF",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogDelivery",
        "logs:CreateLogStream",
        "logs:GetLogDelivery",
        "logs:UpdateLogDelivery",
        "logs:DeleteLogDelivery",
        "logs:ListLogDeliveries",
        "logs:PutLogEvents",
        "logs:PutResourcePolicy",
        "logs:DescribeResourcePolicies",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    }
  ]
}
