{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeMLAndRating",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": [
        "arn:aws:lambda:us-east-1:822233328169:function:tradespark-sync-daily-db",
        "arn:aws:lambda:us-east-1:822233328169:function:ml-predict-function",
        "arn:aws:lambda:us-east-1:822233328169:function:ml-rf-nn-blend",
        "arn:aws:lambda:us-east-1:822233328169:function:tradespark-ml-tabnet",
        "arn:aws:lambda:us-east-1:822233328169:function:tradespark-daily-tiers",
        "arn:aws:lambda:us-east-1:822233328169:function:predixa-*"
      ]
    },
    {
      "Sid": "StartNestedStateMachines",
      "Effect": "Allow",
      "Action": ["states:StartExecution"],
      "Resource": [
        "arn:aws:states:us-east-1:822233328169:stateMachine:Predixa-*"
      ]
    },
    {
      "Sid": "DescribeNestedExecutions",
      "Effect": "Allow",
      "Action": [
        "states:DescribeExecution",
        "states:StopExecution"
      ],
      "Resource": [
        "arn:aws:states:us-east-1:822233328169:execution:Predixa-*:*"
      ]
    },
    {
      "Sid": "EventBridgeForSyncNested",
      "Effect": "Allow",
      "Action": [
        "events:PutTargets",
        "events:PutRule",
        "events:DescribeRule"
      ],
      "Resource": [
        "arn:aws:events:us-east-1:822233328169:rule/StepFunctionsGetEventsForStepFunctionsExecutionRule"
      ]
    },
    {
      "Sid": "LogsForSF",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogDelivery",
        "logs:CreateLogStream",
        "logs:GetLogDelivery",
        "logs:UpdateLogDelivery",
        "logs:DeleteLogDelivery",
        "logs:ListLogDeliveries",
        "logs:PutLogEvents",
        "logs:PutResourcePolicy",
        "logs:DescribeResourcePolicies",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    }
  ]
}
