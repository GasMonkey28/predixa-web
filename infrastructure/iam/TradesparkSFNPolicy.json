        "arn:aws:lambda:us-east-1:822233328169:function:predixa-ml1-AMZN",
        "arn:aws:lambda:us-east-1:822233328169:function:predixa-ml2-AMZN",
        "arn:aws:lambda:us-east-1:822233328169:function:predixa-ml3-AMZN",
